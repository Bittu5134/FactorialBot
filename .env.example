DISCORD_TOKEN=your_bot_token_here

# Optional: set for instant slash command syncing during development
# GUILD_ID=123456789012345678

# Optional: seconds to wait between two replies in the same channel
# REPLY_COOLDOWN_SECS=3

# Optional: Discord webhook that receives error logs
# LOG_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/token

# Optional: fraction of replies that carry the Patreon embed (0.1 = 1 in 10)
# SUPPORT_CHANCE=0.1

# Optional: where to keep the settings database
# DB_PATH=/var/lib/factorialbot/factorialbot.db
